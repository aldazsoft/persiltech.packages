@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Abrir el menú"
                       OnClick="@(() => drawerIsOpen = !drawerIsOpen)" />

        <MudText Typo="Typo.h6">Persiltech.Validation.Blazor</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerIsOpen" Elevation="1" Variant="@DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PersonAdd">
                Registro
            </MudNavLink>
            <MudNavLink Href="controles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">
                Controles
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerIsOpen = true;
}
