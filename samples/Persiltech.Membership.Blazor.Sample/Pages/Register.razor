@page "/register"

<MudText Typo="Typo.h5" GutterBottom="true">Crear cuenta</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST user/register</code> — devuelve 201 sin cuerpo. La política de contraseñas la pone
    ASP.NET Core Identity, así que sus mensajes llegan en la clave <code>password</code>.
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    El formulario es <code>MembershipRegisterForm</code>, del paquete. No abre la sesión: si la API
    exige confirmar el correo, entrar todavía no es posible.
</MudText>

<MudCard Outlined="true" Style="max-width: 520px">
    <MudCardContent>
        <MembershipRegisterForm OnRegistered="OnRegisteredAsync" />
    </MudCardContent>
</MudCard>

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private Task OnRegisteredAsync(string email)
    {
        Snackbar.Add($"Cuenta creada para {email}.", Severity.Success);
        Navigation.NavigateTo($"login?email={Uri.EscapeDataString(email)}");

        return Task.CompletedTask;
    }
}
