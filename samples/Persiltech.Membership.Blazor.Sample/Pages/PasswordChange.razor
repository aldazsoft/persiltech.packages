@page "/password/change"
@attribute [Authorize]

<MudText Typo="Typo.h5" GutterBottom="true">Cambiar la contraseña</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST password/change</code> — exige la contraseña actual, así que no sirve un token robado
    por sí solo para tomar la cuenta.
</MudText>

<ApiErrors Errors="Errors" />

<MudCard Outlined="true" Style="max-width: 520px">
    <MudCardContent>
        <MudTextField @bind-Value="CurrentPassword" Label="Contraseña actual" InputType="InputType.Password" Class="mb-3" />
        <MudTextField @bind-Value="NewPassword" Label="Contraseña nueva" InputType="InputType.Password" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Cambiar</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Inject] private MembershipApiClient Api { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string CurrentPassword = "Passw0rd!";
    private string NewPassword = "Passw0rd!";
    private IReadOnlyDictionary<string, string[]>? Errors;

    private async Task SubmitAsync()
    {
        Errors = null;

        var result = await Api.ChangePasswordAsync(new ChangePasswordRequest(CurrentPassword, NewPassword));

        if (!result.Succeeded)
        {
            Errors = result.Errors;
            return;
        }

        Snackbar.Add("Contraseña cambiada.", Severity.Success);
    }
}
