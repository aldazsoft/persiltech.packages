@page "/password/forgot"

<MudText Typo="Typo.h5" GutterBottom="true">Olvidé la contraseña</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST password/forgot</code> — responde <b>204 siempre</b>, exista la cuenta o no. Es deliberado:
    una respuesta distinta revelaría qué correos están registrados. En el sample, el testigo sale por el
    log de la API, porque el puerto de correo lo implementa el consumidor.
</MudText>

<ApiErrors Errors="Errors" />

<MudCard Outlined="true" Style="max-width: 520px">
    <MudCardContent>
        <MudTextField @bind-Value="Email" Label="Correo" InputType="InputType.Email" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Enviar</MudButton>
        <MudButton Variant="Variant.Text" Href="password/reset">Ya tengo el testigo</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Inject] private MembershipApiClient Api { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private string Email = "admin@example.com";
    private IReadOnlyDictionary<string, string[]>? Errors;

    private async Task SubmitAsync()
    {
        Errors = null;

        var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest(Email));

        if (!result.Succeeded)
        {
            Errors = result.Errors;
            return;
        }

        Snackbar.Add($"La API respondió {(int)result.StatusCode}. Busca el testigo en el log.", Severity.Info);
    }
}
