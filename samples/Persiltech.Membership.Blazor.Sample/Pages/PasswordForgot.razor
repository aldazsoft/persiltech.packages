@page "/password/forgot"

<MudText Typo="Typo.h5" GutterBottom="true">Olvidé la contraseña</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST password/forgot</code> — responde <strong>204 siempre</strong>, exista o no la cuenta,
    para no convertirse en un verificador de qué correos están registrados. Que responda bien no
    significa que se haya enviado nada.
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    El formulario es <code>MembershipForgotPasswordForm</code>, del paquete.
</MudText>

<MudCard Outlined="true" Style="max-width: 520px">
    <MudCardContent>
        <MembershipForgotPasswordForm OnRequested="OnRequestedAsync" />
    </MudCardContent>
</MudCard>

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private Task OnRequestedAsync(string email)
    {
        Snackbar.Add($"Petición cursada para {email}. Si la cuenta existe, recibirá el enlace.", Severity.Info);

        return Task.CompletedTask;
    }
}
