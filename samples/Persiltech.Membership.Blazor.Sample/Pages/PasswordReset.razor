@page "/password/reset"

<MudText Typo="Typo.h5" GutterBottom="true">Reiniciar la contraseña</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST password/reset</code> — con el testigo que se emitió al pedir el olvido. Un testigo
    usado o caducado se rechaza con 400.
</MudText>

<ApiErrors Errors="Errors" />

<MudCard Outlined="true" Style="max-width: 640px">
    <MudCardContent>
        <MudTextField @bind-Value="Email" Label="Correo" InputType="InputType.Email" Class="mb-3" />
        <MudTextField @bind-Value="Token" Label="Testigo" Lines="3" Class="mb-3"
                      HelperText="Cópialo del log de la API." />
        <MudTextField @bind-Value="NewPassword" Label="Contraseña nueva" InputType="InputType.Password" />
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Reiniciar</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Inject] private MembershipApiClient Api { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string Email = "admin@example.com";
    private string Token = string.Empty;
    private string NewPassword = "Passw0rd!";
    private IReadOnlyDictionary<string, string[]>? Errors;

    private async Task SubmitAsync()
    {
        Errors = null;

        var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(Email, Token, NewPassword));

        if (!result.Succeeded)
        {
            Errors = result.Errors;
            return;
        }

        Snackbar.Add("Contraseña reiniciada. Ya puedes entrar con la nueva.", Severity.Success);
        Navigation.NavigateTo("login");
    }
}
