@page "/password/reset"

<MudText Typo="Typo.h5" GutterBottom="true">Reiniciar contraseña</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    <code>POST password/reset</code> — fija la contraseña con el testigo que llegó por correo. El
    correo y el testigo se rellenan solos desde la cadena de consulta del enlace. Cambiarla
    <strong>revoca todas las sesiones abiertas</strong> de la cuenta.
</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    El formulario es <code>MembershipResetPasswordForm</code>, del paquete.
</MudText>

<MudCard Outlined="true" Style="max-width: 520px">
    <MudCardContent>
        <MembershipResetPasswordForm InitialEmail="@Email" InitialToken="@Token" OnReset="OnResetAsync" />
    </MudCardContent>
</MudCard>

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private Task OnResetAsync()
    {
        Snackbar.Add("Contraseña cambiada. Vuelve a entrar.", Severity.Success);
        Navigation.NavigateTo("login");

        return Task.CompletedTask;
    }
}
