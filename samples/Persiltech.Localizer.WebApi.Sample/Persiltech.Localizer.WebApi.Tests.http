@HostAddress = http://localhost:5154

### The value follows the culture negotiated for the request.
GET {{HostAddress}}/localizer/message
Accept-Language: en-US

###
GET {{HostAddress}}/localizer/message
Accept-Language: es-PE

### The value is read in an explicit culture, whatever the request negotiated.
GET {{HostAddress}}/localizer/message/en-US
Accept-Language: es-PE
