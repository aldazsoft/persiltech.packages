<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Persiltech.Results</PackageId>
    <Title>Persiltech.Results</Title>
    <Description>An implementation of the Result pattern: operations return success or failure as a value, with localized error messages, instead of throwing.</Description>
    <VersionPrefix>1.0.1</VersionPrefix>
    <PackageTags>dotnet;csharp;result;railway;error-handling;functional</PackageTags>
    <Authors>Edinson Aldaz</Authors>
    <Company>Persiltech</Company>
    <Product>Persiltech.Results</Product>
    <Copyright>Copyright © 2026 Persiltech</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://aldazsoft.github.io/Results/</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReleaseNotes>
      v1.0.1
      - The project website now points to the portfolio page, where the package is documented
      - The real licence text ships inside the .nupkg instead of an SPDX expression
      - The public surface is documented with XML comments, so IntelliSense works for consumers
    </PackageReleaseNotes>
  </PropertyGroup>

  <!-- <PackageLicenseFile>, <PackageReadmeFile> y <PackageIcon> exigen que el archivo viaje dentro del .nupkg. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Referencia de proyecto, no de paquete: los dos viven en el mismo repositorio y un
       cambio en el paquete base tiene que verse aquí sin pasar por nuget.org. -->
  <ItemGroup>
    <ProjectReference Include="..\Persiltech.Localizer\Persiltech.Localizer.csproj" />
  </ItemGroup>

</Project>
