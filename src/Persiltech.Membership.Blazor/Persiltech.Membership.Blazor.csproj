<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Persiltech.Membership.Blazor</PackageId>
    <Title>Persiltech.Membership.Blazor</Title>
    <Description>Cliente Blazor de Persiltech.Membership: estado de autenticacion a partir del JWT que emite la API, renovacion automatica de la sesion, el manejador que firma cada peticion y los componentes de MudBlazor de sus pantallas.</Description>
    <VersionPrefix>2.0.0</VersionPrefix>
    <!-- Preliberacion: el identificador ya lo ocupaba el paquete del monorepo viejo, que
         llego a 1.0.1. Este es su sucesor y sustituye la API entera, de ahi el mayor; el
         sufijo dice que la superficie todavia se mueve. -->
    <VersionSuffix>preview.4</VersionSuffix>
    <PackageTags>dotnet;csharp;blazor;webassembly;mudblazor;membership;identity;jwt;authentication</PackageTags>
    <Authors>Edinson Aldaz</Authors>
    <Company>Persiltech</Company>
    <Product>Persiltech.Membership.Blazor</Product>
    <Copyright>Copyright © 2026 Persiltech</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReleaseNotes>
      v2.0.0-preview.4
      - Los cuatro formularios pasan a EditForm y muestran cada error de la API bajo el campo que lo provocó, con Persiltech.Validation.Blazor
      - Desaparece MembershipValidationErrors: ya no hay un cartel que reúna los errores de todos los campos
      - El aviso de que las dos contraseñas no coinciden sale bajo su campo, no en un cartel aparte
      - Los campos obligatorios y el formato del correo se comprueban en el navegador, sin ir al servidor
      - Los botones envían el formulario, así que la tecla Intro funciona
    </PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://aldazsoft.github.io/Membership.Blazor/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aldazsoft/persiltech.packages.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- <PackageLicenseFile>, <PackageReadmeFile> y <PackageIcon> exigen que el archivo viaje dentro del .nupkg. -->
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Aquí NO se usa <FrameworkReference Include="Microsoft.AspNetCore.App" />, al contrario
       que en el resto de librerías de la casa: una Razor Class Library que lo declare rompe a
       las aplicaciones Blazor WebAssembly, que no referencian ese framework compartido. El SDK
       es Microsoft.NET.Sdk.Razor porque es lo que compila los .razor y publica wwwroot/ como
       static web asset. Es el mismo criterio que Persiltech.Blazor.JSInterop. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <!-- El vecino que lleva los errores de la API al campo que los provocó. Va por
       ProjectReference y no por PackageReference: dentro del monorepo el proyecto de al lado es
       la fuente de verdad, y es 'dotnet pack' quien lo traduce a dependencia NuGet tomando su
       <VersionPrefix>. Esto baja este paquete al nivel 2 del orden de publicación. -->
  <ItemGroup>
    <ProjectReference Include="../Persiltech.Validation.Blazor/Persiltech.Validation.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Persiltech.Membership.Blazor.Tests" />
  </ItemGroup>

</Project>
