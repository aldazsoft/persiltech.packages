@namespace Persiltech.Membership.Blazor.Components

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ApiValidator @ref="Validator" UnmatchedChanged="OnUnmatchedChanged" />

    @if (Unmatched.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            @foreach (var message in Unmatched)
            {
                <MudText Typo="Typo.body2">@message</MudText>
            }
        </MudAlert>
    }

    <MudTextField For="@(() => Model.Email)"
                  @bind-Value="Model.Email"
                  Label="Correo"
                  InputType="InputType.Email"
                  Margin="@FieldMargin"
                  Disabled="Busy" />

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="Busy"
               Class="mt-4">
        @SubmitLabel
    </MudButton>
</EditForm>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la API acepta la petición, con el correo indicado.
    /// </summary>
    /// <remarks>
    /// La API responde igual exista o no la cuenta, para no revelar qué correos están
    /// registrados. Así que esto no significa que se haya enviado nada: significa que la
    /// petición se cursó, y el mensaje que se muestre debe decir eso mismo.
    /// </remarks>
    [Parameter]
    public EventCallback<string> OnRequested { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Enviar el enlace";

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private readonly ForgotPasswordFormModel Model = new();

    private ApiValidator Validator = default!;
    private IReadOnlyList<string> Unmatched = [];
    private bool Busy;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    private void OnUnmatchedChanged(IReadOnlyList<string> messages) => Unmatched = messages;

    private async Task SubmitAsync()
    {
        Busy = true;

        var result = await Api.ForgotPasswordAsync(
            new ForgotPasswordRequest(Model.Email ?? string.Empty));

        Busy = false;

        if (!result.Succeeded)
        {
            Validator.Show(result.Errors);

            return;
        }

        await OnRequested.InvokeAsync(Model.Email ?? string.Empty);
    }
}
