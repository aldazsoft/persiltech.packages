@namespace Persiltech.Membership.Blazor.Components

@if (Errors is { Count: > 0 })
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
        <MudText Typo="Typo.subtitle2">@Title</MudText>
        @foreach (var entry in Errors)
        {
            @foreach (var message in entry.Value)
            {
                <MudText Typo="Typo.body2">@message</MudText>
            }
        }
    </MudAlert>
}

@code {
    /// <summary>
    /// Errores por campo, tal como los devolvió la API.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, string[]>? Errors { get; set; }

    /// <summary>
    /// Encabezado del aviso.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "La API rechazó la petición";
}
