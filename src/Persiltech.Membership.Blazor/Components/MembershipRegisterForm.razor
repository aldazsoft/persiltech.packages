@namespace Persiltech.Membership.Blazor.Components

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ApiValidator @ref="Validator" UnmatchedChanged="OnUnmatchedChanged" />

    @if (Unmatched.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true"
                  UserAttributes="@MembershipFormAttributes.Alert">
            @foreach (var message in Unmatched)
            {
                <MudText Typo="Typo.body2">@message</MudText>
            }
        </MudAlert>
    }

    <MudTextField For="@(() => Model.FirstName)"
                  @bind-Value="Model.FirstName"
                  Label="@Texts.Value.FirstName"
                  Margin="@FieldMargin"
                  Disabled="Busy"
                  AutoFocus="true"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("given-name")" />

    <MudTextField For="@(() => Model.LastName)"
                  @bind-Value="Model.LastName"
                  Label="@Texts.Value.LastName"
                  Margin="@FieldMargin"
                  Disabled="Busy"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("family-name")" />

    <MudTextField For="@(() => Model.Email)"
                  @bind-Value="Model.Email"
                  Label="@Texts.Value.Email"
                  InputType="InputType.Email"
                  InputMode="InputMode.email"
                  Margin="@FieldMargin"
                  Disabled="Busy"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("username")" />

    @* new-password, no current-password: es lo que hace que el gestor de contraseñas ofrezca
       generar una en lugar de rellenar la que ya tuviera guardada para este sitio. *@
    <MudTextField For="@(() => Model.Password)"
                  @bind-Value="Model.Password"
                  Label="@Texts.Value.Password"
                  InputType="@PasswordInputType"
                  Margin="@FieldMargin"
                  HelperText="@PasswordHelperText"
                  Disabled="Busy"
                  Adornment="Adornment.End"
                  AdornmentIcon="@PasswordAdornmentIcon"
                  AdornmentAriaLabel="@PasswordAdornmentLabel"
                  OnAdornmentClick="TogglePasswordVisibility"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("new-password")" />

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="Busy"
               Class="mt-4">
        @if (Busy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            @Texts.Value.Working
        }
        else
        {
            @SubmitLabel
        }
    </MudButton>
</EditForm>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;
    [Inject] private IOptions<MembershipFormTexts> Texts { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la cuenta ya está creada, con el correo con el que se registró.
    /// </summary>
    /// <remarks>
    /// No abre la sesión: según la política de la API, la cuenta puede necesitar confirmar
    /// el correo antes de poder entrar, y decidir eso es del consumidor.
    /// </remarks>
    [Parameter]
    public EventCallback<string> OnRegistered { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Crear cuenta";

    /// <summary>
    /// Reglas de la contraseña, para decirlas antes de que falle el intento.
    /// </summary>
    /// <remarks>
    /// Las fija la política de Identity del consumidor, que el paquete no conoce. Sin esto,
    /// la primera noticia de que la contraseña no vale llega después de enviarla.
    /// </remarks>
    [Parameter]
    public string? PasswordHelperText { get; set; }

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private readonly RegisterFormModel Model = new();

    private ApiValidator Validator = default!;
    private IReadOnlyList<string> Unmatched = [];
    private bool Busy;
    private bool PasswordIsVisible;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    private InputType PasswordInputType => PasswordIsVisible ? InputType.Text : InputType.Password;

    private string PasswordAdornmentIcon => PasswordIsVisible
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private string PasswordAdornmentLabel => PasswordIsVisible
        ? Texts.Value.HidePassword
        : Texts.Value.ShowPassword;

    private void OnUnmatchedChanged(IReadOnlyList<string> messages) => Unmatched = messages;

    private void TogglePasswordVisibility() => PasswordIsVisible = !PasswordIsVisible;

    private async Task SubmitAsync()
    {
        Busy = true;

        var result = await Api.RegisterAsync(new RegisterUserRequest(
            Model.Email ?? string.Empty,
            Model.Password ?? string.Empty,
            Model.FirstName ?? string.Empty,
            Model.LastName ?? string.Empty));

        Busy = false;

        if (!result.Succeeded)
        {
            Validator.Show(result.Errors);

            return;
        }

        await OnRegistered.InvokeAsync(Model.Email ?? string.Empty);
    }
}
