@namespace Persiltech.Membership.Blazor.Components

<MembershipValidationErrors Errors="Errors" Title="No se pudo crear la cuenta" />

<MudTextField @bind-Value="Email"
              Label="Correo"
              InputType="InputType.Email"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudTextField @bind-Value="Password"
              Label="Contraseña"
              InputType="InputType.Password"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudTextField @bind-Value="FirstName"
              Label="Nombre"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudTextField @bind-Value="LastName"
              Label="Apellidos"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="SubmitAsync"
           Disabled="Busy"
           Class="mt-4">
    @SubmitLabel
</MudButton>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la cuenta ya está creada, con el correo con el que se registró.
    /// </summary>
    /// <remarks>
    /// No abre la sesión: según la política de la API, la cuenta puede necesitar confirmar
    /// el correo antes de poder entrar, y decidir eso es del consumidor.
    /// </remarks>
    [Parameter]
    public EventCallback<string> OnRegistered { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Crear cuenta";

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private string Email = string.Empty;
    private string Password = string.Empty;
    private string FirstName = string.Empty;
    private string LastName = string.Empty;
    private bool Busy;
    private IReadOnlyDictionary<string, string[]>? Errors;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    private async Task SubmitAsync()
    {
        Busy = true;
        Errors = null;

        var result = await Api.RegisterAsync(new RegisterUserRequest(Email, Password, FirstName, LastName));

        Busy = false;

        if (!result.Succeeded)
        {
            Errors = result.Errors;

            return;
        }

        await OnRegistered.InvokeAsync(Email);
    }
}
