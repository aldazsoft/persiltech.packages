@namespace Persiltech.Membership.Blazor.Components
@inject NavigationManager Navigation

<MembershipValidationErrors Errors="Errors" />

@if (!string.IsNullOrWhiteSpace(LocalError))
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">@LocalError</MudAlert>
}

@* Bloqueado solo cuando vino del enlace: quien abra la ruta a pelo tiene que poder escribirlo
   o la pantalla no sirve de nada. De solo lectura y no deshabilitado, para que se lea como
   «esta es tu cuenta» y no como un campo averiado. *@
<MudTextField @bind-Value="Email"
              Label="Correo"
              InputType="InputType.Email"
              Margin="@FieldMargin"
              ReadOnly="@EmailIsLocked"
              Adornment="@(EmailIsLocked ? Adornment.End : Adornment.None)"
              AdornmentIcon="@Icons.Material.Filled.Lock"
              HelperText="@(EmailIsLocked ? "La cuenta para la que se pidió el cambio." : null)"
              Disabled="Busy" />

@* El testigo no se pinta. Es una credencial: quien lo tenga puede cambiar la contraseña de esa
   cuenta hasta que caduque, así que enseñarlo en un campo solo consigue que acabe copiado en un
   chat o en una captura de pantalla. La página ya lo trae del enlace. *@

<MudTextField @bind-Value="NewPassword"
              Label="Contraseña nueva"
              InputType="InputType.Password"
              Margin="@FieldMargin"
              HelperText="@PasswordHelperText"
              Disabled="Busy" />

<MudTextField @bind-Value="ConfirmPassword"
              Label="Repite la contraseña"
              InputType="InputType.Password"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="SubmitAsync"
           Disabled="Busy"
           Class="mt-4">
    @SubmitLabel
</MudButton>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la contraseña ya está cambiada.
    /// </summary>
    /// <remarks>
    /// Cambiarla revoca todas las sesiones abiertas de esa cuenta, así que después toca
    /// autenticarse de nuevo.
    /// </remarks>
    [Parameter]
    public EventCallback OnReset { get; set; }

    /// <summary>
    /// Correo con el que se rellena el campo al aparecer.
    /// </summary>
    /// <remarks>
    /// Tanto este como <see cref="InitialToken"/> suelen venir de la cadena de consulta del
    /// enlace que la API mandó por correo. Si llega con valor, el campo queda de solo lectura.
    /// </remarks>
    [Parameter]
    public string? InitialEmail { get; set; }

    /// <summary>
    /// Testigo de reinicio, que no se muestra en ningún momento.
    /// </summary>
    [Parameter]
    public string? InitialToken { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Cambiar la contraseña";

    /// <summary>
    /// Reglas de la contraseña, para decirlas antes de que falle el intento.
    /// </summary>
    /// <remarks>
    /// Las fija la política de Identity del consumidor, que el paquete no conoce.
    /// </remarks>
    [Parameter]
    public string? PasswordHelperText { get; set; }

    /// <summary>
    /// Quita el correo y el testigo de la barra de direcciones en cuanto se leen.
    /// </summary>
    /// <remarks>
    /// El testigo viaja en la URL porque es la única forma de hacérselo llegar a alguien por
    /// correo, pero ahí se queda: en el historial del navegador y a la vista de quien mire la
    /// pantalla. Una vez en memoria ya no hace falta, así que se reemplaza la entrada del
    /// historial por la ruta limpia.
    /// <para>
    /// Se puede desactivar para un consumidor que necesite conservar la cadena de consulta.
    /// </para>
    /// </remarks>
    [Parameter]
    public bool ClearQueryString { get; set; } = true;

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private string Email = string.Empty;
    private string Token = string.Empty;
    private string NewPassword = string.Empty;
    private string ConfirmPassword = string.Empty;
    private bool Busy;
    private bool EmailIsLocked;
    private string? LocalError;
    private IReadOnlyDictionary<string, string[]>? Errors;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    protected override void OnParametersSet()
    {
        Email = InitialEmail ?? Email;
        Token = InitialToken ?? Token;

        // Se queda bloqueado una vez que lo estuvo, igual que los dos valores de arriba
        // conservan el suyo. Al limpiar la cadena de consulta la página vuelve a leer sus
        // parámetros, ahora vacíos, y recalcularlo desde cero desbloquearía el campo.
        EmailIsLocked = EmailIsLocked || ResetPasswordValidation.ShouldLockEmail(InitialEmail);

        RemoveTokenFromAddressBar();
    }

    private void RemoveTokenFromAddressBar()
    {
        if (!ClearQueryString || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        var uri = new Uri(Navigation.Uri);

        if (string.IsNullOrEmpty(uri.Query))
        {
            return;
        }

        // replace: sustituye la entrada del historial en lugar de añadir otra, para que el
        // botón de atrás no devuelva a la URL con el testigo dentro.
        Navigation.NavigateTo(uri.GetLeftPart(UriPartial.Path), forceLoad: false, replace: true);
    }

    private async Task SubmitAsync()
    {
        LocalError = ResetPasswordValidation.Validate(NewPassword, ConfirmPassword);

        if (LocalError is not null)
        {
            return;
        }

        Busy = true;
        Errors = null;

        var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(Email, Token, NewPassword));

        Busy = false;

        if (!result.Succeeded)
        {
            Errors = result.Errors;

            return;
        }

        await OnReset.InvokeAsync();
    }
}
