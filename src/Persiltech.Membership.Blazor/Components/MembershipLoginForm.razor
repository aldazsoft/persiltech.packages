@namespace Persiltech.Membership.Blazor.Components

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    @* La de cliente resuelve lo que el navegador sabe comprobar solo; ApiValidator trae lo que
       solo sabe el servidor —que la contraseña no es esa—. Las dos escriben en el mismo sitio,
       así que el mensaje sale bajo su campo venga de donde venga. *@
    <DataAnnotationsValidator />
    <ApiValidator @ref="Validator" UnmatchedChanged="OnUnmatchedChanged" />

    @if (Unmatched.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
            @foreach (var message in Unmatched)
            {
                <MudText Typo="Typo.body2">@message</MudText>
            }
        </MudAlert>
    }

    <MudTextField For="@(() => Model.Email)"
                  @bind-Value="Model.Email"
                  Label="Correo"
                  InputType="InputType.Email"
                  Margin="@FieldMargin"
                  Disabled="Busy" />

    <MudTextField For="@(() => Model.Password)"
                  @bind-Value="Model.Password"
                  Label="Contraseña"
                  InputType="InputType.Password"
                  Margin="@FieldMargin"
                  Disabled="Busy" />

    @if (TwoFactorRequired)
    {
        <MudTextField For="@(() => Model.TwoFactorCode)"
                      @bind-Value="Model.TwoFactorCode"
                      Label="Código del doble factor"
                      Margin="@FieldMargin"
                      Disabled="Busy" />
    }

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="Busy"
               Class="mt-4">
        @SubmitLabel
    </MudButton>
</EditForm>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;
    [Inject] private MembershipAuthenticationStateProvider Auth { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la sesión ya está abierta, con los testigos recién emitidos.
    /// </summary>
    /// <remarks>
    /// El formulario ya llamó a <c>SignInAsync</c> antes de esto: a dónde ir después es lo
    /// único que queda por decidir, y esa decisión es de la aplicación.
    /// </remarks>
    [Parameter]
    public EventCallback<MembershipTokens> OnLoggedIn { get; set; }

    /// <summary>
    /// Correo con el que se rellena el campo al aparecer.
    /// </summary>
    [Parameter]
    public string? InitialEmail { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Entrar";

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private readonly LoginFormModel Model = new();

    private ApiValidator Validator = default!;
    private IReadOnlyList<string> Unmatched = [];
    private bool Busy;
    private bool TwoFactorRequired;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    protected override void OnInitialized() => Model.Email = InitialEmail;

    private void OnUnmatchedChanged(IReadOnlyList<string> messages) => Unmatched = messages;

    private async Task SubmitAsync()
    {
        Busy = true;

        var result = await Api.LoginAsync(new LoginUserRequest(
            Model.Email ?? string.Empty,
            Model.Password ?? string.Empty,
            string.IsNullOrWhiteSpace(Model.TwoFactorCode) ? null : Model.TwoFactorCode));

        Busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            Validator.Show(result.Errors);

            // El campo del segundo factor solo aparece cuando la API lo pide. Mostrarlo
            // siempre invitaría a rellenarlo a quien no lo tiene activado.
            TwoFactorRequired |= result.Errors.ContainsKey("twoFactorCode");

            return;
        }

        await Auth.SignInAsync(result.Value);
        await OnLoggedIn.InvokeAsync(result.Value);
    }
}
