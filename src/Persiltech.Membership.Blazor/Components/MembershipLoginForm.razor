@namespace Persiltech.Membership.Blazor.Components

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    @* La de cliente resuelve lo que el navegador sabe comprobar solo; ApiValidator trae lo que
       solo sabe el servidor —que la contraseña no es esa—. Las dos escriben en el mismo sitio,
       así que el mensaje sale bajo su campo venga de donde venga. *@
    <DataAnnotationsValidator />
    <ApiValidator @ref="Validator" UnmatchedChanged="OnUnmatchedChanged" />

    @* role="alert" para que un lector de pantalla lo lea al aparecer: quien no ve la pantalla
       no tiene forma de enterarse de que el intento falló. *@
    @if (Unmatched.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true"
                  UserAttributes="@MembershipFormAttributes.Alert">
            @foreach (var message in Unmatched)
            {
                <MudText Typo="Typo.body2">@message</MudText>
            }
        </MudAlert>
    }

    @* autocomplete: sin él, ningún gestor de contraseñas ofrece rellenar ni guardar. Es la
       diferencia entre entrar de un toque y teclear una contraseña larga en un móvil.

       AutoFocus es el parámetro de MudBlazor, que enfoca por JS, y no el atributo autofocus de
       HTML: el navegador solo honra el atributo al analizar el documento, así que en una SPA no
       haría nada al llegar a esta pantalla navegando desde otra. *@
    <MudTextField For="@(() => Model.Email)"
                  @bind-Value="Model.Email"
                  Label="@Texts.Value.Email"
                  InputType="InputType.Email"
                  InputMode="InputMode.email"
                  Margin="@FieldMargin"
                  Disabled="Busy"
                  AutoFocus="@(string.IsNullOrEmpty(InitialEmail))"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("username")" />

    <MudTextField For="@(() => Model.Password)"
                  @bind-Value="Model.Password"
                  Label="@Texts.Value.Password"
                  InputType="@PasswordInputType"
                  Margin="@FieldMargin"
                  Disabled="Busy"
                  Adornment="Adornment.End"
                  AdornmentIcon="@PasswordAdornmentIcon"
                  AdornmentAriaLabel="@PasswordAdornmentLabel"
                  OnAdornmentClick="TogglePasswordVisibility"
                  AutoFocus="@(!string.IsNullOrEmpty(InitialEmail))"
                  UserAttributes="@MembershipFormAttributes.AutoComplete("current-password")" />

    @* Solo aparece cuando la API lo pide. Mostrarlo siempre invitaría a rellenarlo a quien no
       tiene el doble factor activado. *@
    @if (TwoFactorRequired)
    {
        <MudTextField For="@(() => Model.TwoFactorCode)"
                      @bind-Value="Model.TwoFactorCode"
                      Label="@Texts.Value.TwoFactorCode"
                      InputMode="InputMode.numeric"
                      Margin="@FieldMargin"
                      Disabled="Busy"
                      UserAttributes="@MembershipFormAttributes.AutoComplete("one-time-code")" />
    }

    <MudButton ButtonType="ButtonType.Submit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Disabled="Busy"
               Class="mt-4">
        @if (Busy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            @Texts.Value.Working
        }
        else
        {
            @SubmitLabel
        }
    </MudButton>
</EditForm>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;
    [Inject] private MembershipAuthenticationStateProvider Auth { get; set; } = default!;
    [Inject] private IOptions<MembershipFormTexts> Texts { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la sesión ya está abierta, con los testigos recién emitidos.
    /// </summary>
    /// <remarks>
    /// El formulario ya llamó a <c>SignInAsync</c> antes de esto: a dónde ir después es lo
    /// único que queda por decidir, y esa decisión es de la aplicación.
    /// </remarks>
    [Parameter]
    public EventCallback<MembershipTokens> OnLoggedIn { get; set; }

    /// <summary>
    /// Correo con el que se rellena el campo al aparecer.
    /// </summary>
    /// <remarks>
    /// Cuando llega con valor, el foco arranca en la contraseña: reescribir un correo que ya
    /// está puesto no es lo que nadie viene a hacer.
    /// </remarks>
    [Parameter]
    public string? InitialEmail { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Entrar";

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private readonly LoginFormModel Model = new();

    private ApiValidator Validator = default!;
    private IReadOnlyList<string> Unmatched = [];
    private bool Busy;
    private bool TwoFactorRequired;
    private bool PasswordIsVisible;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    private InputType PasswordInputType => PasswordIsVisible ? InputType.Text : InputType.Password;

    private string PasswordAdornmentIcon => PasswordIsVisible
        ? Icons.Material.Filled.VisibilityOff
        : Icons.Material.Filled.Visibility;

    private string PasswordAdornmentLabel => PasswordIsVisible
        ? Texts.Value.HidePassword
        : Texts.Value.ShowPassword;

    protected override void OnInitialized() => Model.Email = InitialEmail;

    private void OnUnmatchedChanged(IReadOnlyList<string> messages) => Unmatched = messages;

    private void TogglePasswordVisibility() => PasswordIsVisible = !PasswordIsVisible;

    private async Task SubmitAsync()
    {
        Busy = true;

        var result = await Api.LoginAsync(new LoginUserRequest(
            Model.Email ?? string.Empty,
            Model.Password ?? string.Empty,
            string.IsNullOrWhiteSpace(Model.TwoFactorCode) ? null : Model.TwoFactorCode));

        Busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            Validator.Show(result.Errors);

            TwoFactorRequired |= result.Errors.ContainsKey("twoFactorCode");

            return;
        }

        await Auth.SignInAsync(result.Value);
        await OnLoggedIn.InvokeAsync(result.Value);
    }
}
