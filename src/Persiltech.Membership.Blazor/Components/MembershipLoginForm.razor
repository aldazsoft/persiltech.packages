@namespace Persiltech.Membership.Blazor.Components

<MembershipValidationErrors Errors="Errors" Title="No se pudo entrar" />

<MudTextField @bind-Value="Email"
              Label="Correo"
              InputType="InputType.Email"
              Margin="@FieldMargin"
              Disabled="Busy" />

<MudTextField @bind-Value="Password"
              Label="Contraseña"
              InputType="InputType.Password"
              Margin="@FieldMargin"
              Disabled="Busy" />

@if (TwoFactorRequired)
{
    <MudTextField @bind-Value="TwoFactorCode"
                  Label="Código del doble factor"
                  Margin="@FieldMargin"
                  Disabled="Busy" />
}

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="SubmitAsync"
           Disabled="Busy"
           Class="mt-4">
    @SubmitLabel
</MudButton>

@code {
    [Inject] private IMembershipApiClient Api { get; set; } = default!;
    [Inject] private MembershipAuthenticationStateProvider Auth { get; set; } = default!;

    /// <summary>
    /// Se invoca cuando la sesión ya está abierta, con los testigos recién emitidos.
    /// </summary>
    /// <remarks>
    /// El formulario ya llamó a <c>SignInAsync</c> antes de esto: a dónde ir después es lo
    /// único que queda por decidir, y esa decisión es de la aplicación.
    /// </remarks>
    [Parameter]
    public EventCallback<MembershipTokens> OnLoggedIn { get; set; }

    /// <summary>
    /// Correo con el que se rellena el campo al aparecer.
    /// </summary>
    [Parameter]
    public string? InitialEmail { get; set; }

    /// <summary>
    /// Texto del botón.
    /// </summary>
    [Parameter]
    public string SubmitLabel { get; set; } = "Entrar";

    /// <summary>
    /// Campos compactos, para encajar en un diálogo.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    private string Email = string.Empty;
    private string Password = string.Empty;
    private string TwoFactorCode = string.Empty;
    private bool Busy;
    private bool TwoFactorRequired;
    private IReadOnlyDictionary<string, string[]>? Errors;

    private Margin FieldMargin => Dense ? Margin.Dense : Margin.Normal;

    protected override void OnInitialized() => Email = InitialEmail ?? string.Empty;

    private async Task SubmitAsync()
    {
        Busy = true;
        Errors = null;

        var result = await Api.LoginAsync(
            new LoginUserRequest(Email, Password, string.IsNullOrWhiteSpace(TwoFactorCode) ? null : TwoFactorCode));

        Busy = false;

        if (!result.Succeeded || result.Value is null)
        {
            Errors = result.Errors;

            // El campo del segundo factor solo aparece cuando la API lo pide. Mostrarlo
            // siempre invitaría a rellenarlo a quien no lo tiene activado.
            TwoFactorRequired |= result.Errors.ContainsKey("twoFactorCode");

            return;
        }

        await Auth.SignInAsync(result.Value);
        await OnLoggedIn.InvokeAsync(result.Value);
    }
}
