<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Persiltech.DomainValidation</PackageId>
    <Title>Clean Architecture: DomainValidation</Title>
    <Description>Una biblioteca .NET para validación de reglas de negocio en aplicaciones que implementan Clean Architecture, desarrollada durante el entrenamiento "Introducción a Clean Architecture en aplicaciones .NET" impartido por Miguel Muñoz Serafín.</Description>
    <VersionPrefix>2.0.2</VersionPrefix>
    <PackageTags>clean-architecture;business-rules;validation;dotnet;csharp;architecture</PackageTags>
    <Authors>Edinson Aldaz</Authors>
    <Company>Persiltech</Company>
    <Product>Persiltech.DomainValidation</Product>
    <Copyright>Copyright © 2026 Persiltech</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://aldazsoft.github.io/DomainValidation/</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReleaseNotes>
      v2.0.2
      - Renueva el icono del paquete: la mitad de peso (12 401 -> 6 575 bytes) con la misma resolución de 128 x 128
      - Sin cambios en el código ni en la superficie pública
    </PackageReleaseNotes>
  </PropertyGroup>

  <!-- <PackageLicenseFile>, <PackageReadmeFile> y <PackageIcon> exigen que el archivo viaje dentro del .nupkg. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- Referencia de proyecto, no de paquete: los dos viven en el mismo repositorio y un
       cambio en el paquete base tiene que verse aquí sin pasar por nuget.org. -->
  <ItemGroup>
    <ProjectReference Include="..\Persiltech.Localizer\Persiltech.Localizer.csproj" />
  </ItemGroup>

</Project>
