<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Persiltech.UserServices</PackageId>
    <Title>Persiltech.UserServices</Title>
    <Description>Implementación para ASP.NET Core de IUserService, el Output Port que define Persiltech.UserServices.Abstractions, que resuelve la identidad y el estado de autenticación del usuario actual a partir de HttpContext.User.</Description>
    <VersionPrefix>0.1.5</VersionPrefix>
    <PackageTags>dotnet;csharp;aspnetcore;authentication;identity;httpcontext;clean-architecture</PackageTags>
    <Authors>Edinson Aldaz</Authors>
    <Company>Persiltech</Company>
    <Product>Persiltech.UserServices</Product>
    <Copyright>Copyright © 2026 Persiltech</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://aldazsoft.github.io/UserServices/</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- <PackageLicenseFile>, <PackageReadmeFile> y <PackageIcon> exigen que el archivo viaje dentro del .nupkg. -->
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Persiltech.UserServices.Tests" />
  </ItemGroup>

  <!-- El framework compartido aporta HttpContext, IHttpContextAccessor y las abstracciones de DI. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Referencia de proyecto, no de paquete: los dos viven en el mismo repositorio y un
       cambio en el contrato tiene que verse aquí sin pasar por nuget.org. -->
  <ItemGroup>
    <ProjectReference Include="..\Persiltech.UserServices.Abstractions\Persiltech.UserServices.Abstractions.csproj" />
  </ItemGroup>

</Project>
